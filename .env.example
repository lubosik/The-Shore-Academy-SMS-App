# ── Telnyx (SMS/MMS + voice on +15613630929) ────────────────────────────────
TELNYX_API_KEY=                  # Telnyx API v2 key
TELNYX_MESSAGING_PROFILE_ID=     # messaging profile the number belongs to
TELNYX_PHONE_NUMBER=             # the Shore Academy number, E.164: +15613630929
TELNYX_SIP_USERNAME=             # legacy SIP credential pair (rollback fallback)
TELNYX_SIP_PASSWORD=             # legacy SIP credential pair (rollback fallback)
TELNYX_IOS_SIP_USERNAME=         # live iOS SIP credential (preferred pair)
TELNYX_IOS_SIP_PASSWORD=         # live iOS SIP credential (preferred pair)
WEBHOOK_SECRET=                  # shared secret for Telnyx webhook signature + /webhook/send auth

# ── Private call recordings ─────────────────────────────────────────────────
CALL_RECORDING_RETENTION_DAYS=30          # archive expiry recorded on every saved call
CALL_RECORDING_SIGNED_URL_SECONDS=60      # authenticated playback redirect lifetime (30–300)
CALL_RECORDING_RETENTION_ENFORCED=false   # keep false until owner approves first destructive purge

# ── GoHighLevel (contact system of record — all automation lives there) ─────
GHL_PIT=                         # private integration token, format pit-...
GHL_LOCATION_ID=                 # sub-account location id
GHL_WEBHOOK_SECRET=              # generated secret in the workflow webhook URL /webhook/ghl/contact/<secret>
GHL_OUTBOUND_MODE=ghl            # ghl = canonical GHL thread + its Telnyx provider; telnyx = emergency rollback
GHL_CONVERSATION_PROVIDER_ID=    # optional: record direct-Telnyx rollback sends in GHL when a Marketplace provider id exists

# ── Supabase (application database) ─────────────────────────────────────────
SUPABASE_URL=                    # https://<project>.supabase.co
SUPABASE_SERVICE_KEY=            # service role key (server-side only, never client)

# ── Auth ────────────────────────────────────────────────────────────────────
INBOX_PASSWORD=                  # login password for the inbox + admin endpoints
SESSION_SECRET=                  # random string signing the session cookie

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3000                        # HTTP port (Railway injects its own)
NODE_ENV=production              # production | development
APP_URL=                         # public base URL, e.g. https://<RAILWAY_URL>

# ── Web Push (browser notifications) — npx web-push generate-vapid-keys ─────
VAPID_SUBJECT=mailto:you@yourdomain.com  # contact for the push service
VAPID_PUBLIC_KEY=                # VAPID public key
VAPID_PRIVATE_KEY=               # VAPID private key

# ── APNs (native iOS message + new-contact alerts) ──────────────────────────
APNS_KEY_ID=                     # Apple APNs auth key id
APNS_TEAM_ID=                    # Apple Developer team id
APNS_KEY_P8_BASE64=              # base64-encoded APNs .p8 private key
APNS_BUNDLE_ID=                  # iOS app bundle id (defaults to the app's built-in id)
